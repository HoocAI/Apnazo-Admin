{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/admin.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/admin/content/terms",
      "destination": "/api/content-terms"
    },
    {
      "source": "/api/content/terms",
      "destination": "/api/content-terms"
    },
    {
      "source": "/api/admin/content/privacy",
      "destination": "/api/content-privacy"
    },
    {
      "source": "/api/content/privacy",
      "destination": "/api/content-privacy"
    },
    {
      "source": "/api/admin/settings",
      "destination": "/api/settings"
    },
    {
      "source": "/api/settings",
      "destination": "/api/settings"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/api/admin/login",
      "destination": "/api/admin-login"
    },
    {
      "source": "/api/admin/agreement",
      "destination": "/api/agreement"
    },
    {
      "source": "/api/agreement",
      "destination": "/api/agreement"
    },
    {
      "source": "/api/admin/seller/decision",
      "destination": "/api/seller-decision"
    },
    {
      "source": "/api/admin/sellers",
      "destination": "/api/admin-sellers"
    },
    {
      "source": "/api/leads",
      "destination": "/api/leads"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ]
}